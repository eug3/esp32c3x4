# GUI Paint Configuration for Xteink X4 EPD
# No special configuration needed - using default ESP-IDF settings

# FATFS: enable UTF-8 API encoding so Chinese/long filenames work
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
# Bluetooth Configuration - Enable BLE support for BLE Reader feature
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LEGACY_VHCI_ENABLE=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# BLE Controller Memory Optimization for ESP32-C3 (Single connection only)
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN_EFF=1
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_BLE_MAX_ACT_EFF=3

# NimBLE Memory Optimization (Optimized for low memory footprint - ESP32-C3 only 50KB available)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=24
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=255
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=70
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=8
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320

# BLE Performance Optimization (2M PHY, DLE, Larger MTU)
# 注意：扩展广播与传统ble_gap_adv_set_fields不兼容，暂时禁用
# CONFIG_BT_NIMBLE_EXT_ADV is not set
CONFIG_BT_CTRL_BLE_2M_PHY=y
CONFIG_BT_CTRL_BLE_2M_PHY_LISR=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY=y
CONFIG_BT_NIMBLE_LL_DLE_DEF_OCTETS=251
CONFIG_BT_CTRL_BLE_TX_OCTET=251
CONFIG_BT_CTRL_BLE_RX_OCTET=251
CONFIG_BT_NIMBLE_GATT_MAX_MTU=517